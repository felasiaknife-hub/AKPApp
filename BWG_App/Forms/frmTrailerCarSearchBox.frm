Attribute VB_Name = "frmTrailerCarSearchBox"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Dim selCar_ As BWGJobDataCarUsedBox
Dim colTimeTable_ As Collection
Dim curInd_ As Integer
Dim isChanged_ As Boolean

Private Sub cmdClose_Click()
    Unload Me
End Sub

Private Sub cmdOpen_Click()
Dim x%, tmpTime As BWGJobDataTimeTableBox
    For x = 1 To txtCar.UBound
        If txtCar(x).Visible Then
            If Trim(txtCar(x).Text) = "" Then
                MsgBox "กรุณาเลือกรถให้ครบทุกคัน", vbExclamation
                txtCar(x).SetFocus
                Exit Sub
            End If
        End If
    Next x
    If isChanged_ Then
        For x = 1 To colTimeTable_.Count
            Set tmpTime = colTimeTable_(x)
            With selCar_.TimeTables(x)
                .TimeTableNo = tmpTime.TimeTableNo ''*** ลองเช็คดูว่ามันเป็นเลขเดียวกันหรือไม่
                .CarRegisNo = tmpTime.CarRegisNo
                .DriverName = tmpTime.DriverName
                .TrailTruckID = tmpTime.TrailTruckID
                .VendorID = tmpTime.VendorID
                .VendorName = tmpTime.VendorName
                .VendorRegisNo = tmpTime.VendorRegisNo
                .VendorTruckID = tmpTime.VendorTruckID
                .VendorWorkerCharge = tmpTime.VendorWorkerCharge
'                .isTrailer = True
            End With
            Set tmpTime = Nothing
        Next x
        selCar_.isChanged = True
        isChanged_ = False
    End If
    Unload Me
End Sub

Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
    If KeyCode = 13 Then SendKeys "{Tab}"
End Sub

Private Sub Form_KeyPress(KeyAscii As Integer)
    If KeyAscii = 13 Then KeyAscii = 0
End Sub

Public Sub SetCar(selCar As BWGJobDataCarUsedBox)
Dim x%, y%
Dim tmpTime As BWGJobDataTimeTableBox
Dim tmpNewTime As BWGJobDataTimeTableBox
    Set selCar_ = selCar
    Set colTimeTable_ = Nothing
    Set colTimeTable_ = New Collection
    With selCar_
        txtCarNo.Text = .carNo
        txtCarType.Text = .TruckTypeName & " (พ่วง), " & .TruckSubTypeName
    
        For x = 1 To .TimeTables.Count
            Set tmpTime = .TimeTables(x)
            Label2(x).Caption = "คันที่ " & x
            txtCar(x).Enabled = True
            If Trim(tmpTime.CarRegisNo) <> "" Then
                txtCar(x).Text = tmpTime.CarRegisNo & " , " & tmpTime.VendorName
            End If
            Label2(x).Visible = True
            txtCar(x).Visible = True
            Set tmpNewTime = tmpTime.getDuplicate
            colTimeTable_.Add tmpNewTime, "'" & tmpNewTime.JobDataCarID & "_" & tmpNewTime.TripNo & "'"
            Set tmpNewTime = Nothing
        Next
        'x = x + 1
        For y = x To Label2.UBound
            Label2(y).Visible = False
            txtCar(y).Visible = False
        Next
    End With
End Sub

Private Sub Form_Load()
    isChanged_ = False
    With frmPicture
        cmdClose.Picture = .picExit.Picture
    End With
End Sub

Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
Dim selResult As Integer
    If isChanged_ Then
        selResult = MsgBox("ข้อมูลมีการเปลี่ยนแปลงต้องการจัดเก็บข้อมูลก่อนปิดหน้าจอหรือไม่?", vbQuestion + vbYesNoCancel)
        If selResult = vbYes Then
            cmdOpen_Click
            If isChanged_ Then Cancel = 1
        ElseIf selResult = vbCancel Then
            Cancel = 1
        End If
    End If
End Sub

Private Sub txtCar_Validate(Index As Integer, Cancel As Boolean)
Dim tmpTime As BWGJobDataTimeTableBox
    Set tmpTime = colTimeTable_(Index)
    curInd_ = Index
    If Trim(txtCar(Index).Text) = "" And Trim(tmpTime.CarRegisNo & " , " & tmpTime.VendorName) <> Trim(txtCar(Index).Text) Then
        With tmpTime
            .CarRegisNo = ""
            .DriverName = ""
            If Index Mod 2 = 0 Then
                colTimeTable_(Index - 1).TrailTruckID = ""
            End If
            .VendorID = ""
            .VendorName = ""
            .VendorRegisNo = ""
            .VendorTruckID = ""
        End With
    Else
        If Trim(tmpTime.CarRegisNo & " , " & tmpTime.VendorName) <> Trim(txtCar(Index).Text) Then
            With tmpTime
                .CarRegisNo = ""
                .DriverName = ""
                If Index Mod 2 = 0 Then
                    colTimeTable_(Index - 1).TrailTruckID = ""
                End If
                .VendorID = ""
                .VendorName = ""
                .VendorRegisNo = ""
                .VendorTruckID = ""
            End With
            Load frmCarVendorSearch
            With frmCarVendorSearch
                If Index Mod 2 = 0 Then
                    .SetCallerForm Me, selCar_.TruckSubTypeID, "T"
                Else
                    .SetCallerForm Me, selCar_.TruckSubTypeID, "H"
                End If
                .getCriteria txtCar(Index).Text
                .Show 1
            End With
            '*** เพิ่มข้อมูลหางรถพ่วง
            If Index Mod 2 = 0 Then
                colTimeTable_(Index - 1).TrailTruckID = tmpTime.VendorTruckID
                tmpTime.TimeTableNo = colTimeTable_(Index - 1).TimeTableNo
            End If
            If tmpTime.CarRegisNo = "" Then txtCar(Index).Text = ""
        End If
    End If
End Sub

Public Sub SetDataCarVendor(selCV As BWGVenderCar)
Dim tmpTime As BWGJobDataTimeTableBox
    Set tmpTime = colTimeTable_(curInd_)
    With tmpTime
        .CarRegisNo = selCV.CarRegisID
        .DriverName = selCV.ContactName
        If curInd_ Mod 2 = 0 Then
            colTimeTable_(curInd_ - 1).TrailTruckID = selCV.ID
        End If
        .VendorID = selCV.VendorID
        .VendorName = selCV.VendorName
        .VendorRegisNo = selCV.VendorLicenseNo
        .VendorTruckID = selCV.ID
        .VendorWorkerCharge = selCV.VendorWorkerCharge
        txtCar(curInd_).Text = .CarRegisNo & " , " & .VendorName
        isChanged_ = True
    End With
End Sub
